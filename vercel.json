{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
       "source": "/products/:path*",
     "destination": "/api/product?path=:path*"
    },
    {
      "source": "/product.html",
      "has": [
        {
          "type": "query",
          "key": "id"
        }
      ],
      "destination": "/api/product?id=:id&legacy=1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://mrqvzmtdsohvzsnryogp.supabase.co/functions/v1/dynamic-worker?sitemap=1"
    }
  ]
}
